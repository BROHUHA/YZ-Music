{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/jiosaavn/(.*)",
      "destination": "https://www.jiosaavn.com/$1"
    },
    {
      "source": "/api/innertube/(.*)",
      "destination": "https://music.youtube.com/youtubei/v1/$1"
    },
    {
      "source": "/api/parties/(.*)",
      "destination": "https://yz-music-party.onrender.com/api/parties/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
