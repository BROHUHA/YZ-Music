{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/innertube/(.*)",
      "destination": "/api/innertube/[...path]?path=$1"
    },
    {
      "source": "/api/jiosaavn",
      "destination": "/api/jiosaavn"
    },
    {
      "source": "/api/parties/(.*)",
      "destination": "https://yz-music-party.onrender.com/api/parties/$1"
    },
    {
      "source": "/api/lrclib/(.*)",
      "destination": "https://lrclib.net/api/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
